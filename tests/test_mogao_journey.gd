extends RefCounted

static func run(t: Node) -> void:
	print("\n[TEST] Mogao pattern gate slice")
	for sample in 16:
		seed(sample * 997)
		var maze := MazeGenerator.new(30, 25)
		var journey := MogaoJourney.new()
		journey.build(maze)
		var before := PathGuide.bfs_path(maze, journey.TABLE, journey.FAMILY).size()
		t.assert_eq(PathGuide.bfs_path(maze, journey.TABLE, journey.SCARF).size(), 19, "closed gate takes eighteen steps around to the scarf")
		t.assert_true(before > 0, "brother reachable without solving")
		t.assert_true(not PathGuide.bfs_path(maze, Vector2i.ZERO, Vector2i(29, 24)).is_empty(), "exit reachable on bypass")
		t.assert_true(maze.has_wall(4, 2, maze.E) and maze.has_wall(5, 2, maze.W), "gate starts closed on both sides")
		t.assert_true(not journey.open_gate(maze), "unsolved pattern cannot open gate")
		journey.puzzle.latches = 1
		t.assert_true(journey.open_gate(maze), "solving opens the physical gate")
		var after := PathGuide.bfs_path(maze, journey.TABLE, journey.FAMILY).size()
		t.assert_eq(PathGuide.bfs_path(maze, Vector2i.ZERO, journey.FAMILY).size() - 1, 22, "open route reaches brother in twenty-two moves")
		t.assert_eq(PathGuide.bfs_path(maze, journey.FAMILY, Vector2i(29, 24)).size() - 1, 35, "post-rescue exit route takes thirty-five moves")
		t.assert_true(before - after >= 12 and after < before * 0.8, "shortcut has meaningful graph-distance reward")
		t.assert_true(not journey.open_gate(maze), "gate reward idempotent")
		t.assert_true(maze.can_move(5, 2, maze.W), "gate traversable in reverse")
		t.assert_true(not journey.rescued, "pattern never counts as family rescue")
		t.assert_true(journey.spawn_exclusions.has(journey.TABLE), "table is a safe point")
		t.assert_eq(PathGuide.bfs_path(maze, journey.TABLE, journey.SCARF).size(), 3, "open shortcut reaches visible scarf in two steps")
		t.assert_true(journey.begin_reveal(), "opening presentation starts on dismissal")
		journey.tick_reveal(maze, 0.4)
		t.assert_true(journey.revealing() and maze.landmarks[journey.GATE].visual_open > 0, "gate leaves visibly animate")
		journey.tick_reveal(maze, 2.0)
		t.assert_true(journey.guiding_to_gate(), "shortcut guide ignores normal walking threshold")
		t.assert_true(not journey.begin_reveal(), "presentation cannot replay")
		journey.enter(journey.TABLE); journey.enter(journey.GATE)
		t.assert_true(journey.crossed_gate and not journey.guiding_to_gate(), "crossing returns guide control to normal game")

	var p := PatternPuzzle.new()
	p.rng.seed = 42
	p.open()
	t.assert_eq(p.phase, "observe", "inspection starts directly with the real board")
	t.assert_eq(p.board.size(), 2, "only two motifs to remember")
	t.assert_true(p.board[0] != p.board[1], "initial motifs are distinct")
	p.tick(60)
	t.assert_eq(p.phase, "observe", "everyone gets self-paced observation without a mode switch")
	t.assert_true(not p.answer(p.changed), "cannot answer before observing")
	p.advance(); p.tick(0.2)
	t.assert_eq(p.phase, "cover", "brief cover separates observation from comparison")
	p.tick(0.3)
	t.assert_eq(p.phase, "probe", "one cover interval leads directly to comparison")
	p.answer(not p.changed)
	t.assert_eq(p.latches, 0, "mistake never awards a latch")
	t.assert_eq(p.phase, "observe", "mistake immediately offers another look without extra confirmation")
	p.suspend(); p.tick(60)
	t.assert_eq(p.phase, "suspended", "focus interruption cannot advance the puzzle")
	p.advance()
	t.assert_eq(p.phase, "observe", "resume returns to observation")
	p.open()
	t.assert_true(p.phase == "observe" and not p.completed(), "reopening an unfinished puzzle starts safely")
	p.advance(); p.tick(1)
	t.assert_true(p.answer(p.changed) and p.completed(), "one correct comparison opens the gate")
	t.assert_true(not p.answer(p.changed), "repeated answer cannot award twice")
	p.open()
	t.assert_eq(p.phase, "done", "completed puzzle stays completed")
	var outcomes := {}
	for i in 40:
		var trial := PatternPuzzle.new()
		trial.rng.seed = i
		trial.open()
		outcomes[trial.changed] = true
		t.assert_eq(trial.probe != trial.board[trial.target], trial.changed, "comparison matches the actual shown motif")
	t.assert_eq(outcomes.size(), 2, "both changed and unchanged rounds occur")
	var guidance := MogaoJourney.new()
	t.assert_true(guidance.enter(MogaoJourney.SIGN).is_empty(), "route choice does not interrupt with a card")
	t.assert_true(guidance.enter(MogaoJourney.SCARF).is_empty() and guidance.scarf_found, "scarf discovery is nonmodal")

	var controller = load("res://scripts/main.gd").new()
	t.add_child(controller)
	DataLoader.set_difficulty("normal")
	controller.game.start_game()
	controller._new_game(1)
	t.assert_eq(controller.maze.theme_key, "mogao", "second chapter uses isolated Mogao presentation")
	var family: Array = []
	for item in controller.items:
		if item.item_type == "key": family.append(item.item_key)
	t.assert_eq(family, ["family_2"], "exactly one older brother spawns")
	for m in controller.monsters:
		t.assert_true(not m.patrol_cells.has(MogaoJourney.TABLE) and not m.patrol_cells.has(MogaoJourney.FAMILY), "monsters cannot enter safe encounter or rescue zone")
	controller.journey_card.visible = false
	var wheel := InputEventMouseButton.new()
	wheel.button_index = MOUSE_BUTTON_WHEEL_DOWN
	wheel.pressed = true
	controller._track_held_input(wheel)
	t.assert_true(controller.held_inputs.is_empty(), "scroll wheel must not leave a held-button latch")
	controller.player.pos = MogaoJourney.TABLE
	controller.attack_cooldown = 0.3
	controller.player.temp_atk_bonus = 3
	controller.player.buff_timer = 4
	for i in 5: controller.inventory.add_item("heal_scroll")
	controller._inspect_pattern()
	t.assert_true(controller._pattern_open(), "inspection opens a real modal")
	var hp: int = controller.player.hp
	var enemy_timer: float = controller.monsters[0].move_timer
	controller._process(4)
	controller._apply_game_action(GameAction.move(MazeGenerator.S))
	controller._on_mobile_action("use_item")
	t.assert_eq(controller.player.pos, MogaoJourney.TABLE, "modal blocks movement")
	t.assert_eq(controller.inventory.get_count(), 5, "modal blocks inventory consumption")
	t.assert_eq(controller.player.hp, hp, "modal freezes combat damage")
	t.assert_eq(controller.attack_cooldown, 0.3, "modal freezes attack cooldown")
	t.assert_eq(controller.monsters[0].move_timer, enemy_timer, "modal freezes enemy clock")
	t.assert_eq(controller.player.buff_timer, 4, "modal does not consume action-based buffs")
	controller._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	t.assert_eq(controller.mogao_journey.puzzle.phase, "suspended", "losing app focus interrupts pattern")
	t.assert_true(controller.game.is_paused(), "losing app focus pauses world as well")
	controller.mogao_journey.puzzle.open()
	controller.mogao_journey.puzzle.latches = 1
	controller._on_pattern_unlocked()
	t.assert_eq(controller.key_tracker.collected_keys, 0, "opening gate never increments rescue counter")
	t.assert_eq(controller.inventory.get_count(), 5, "full inventory never blocks gate")
	controller.pattern_panel.close()
	t.assert_true(controller.game.is_paused(), "closing pattern does not accidentally unpause a backgrounded game")
	controller.game.toggle_pause()
	controller._process(0.4)
	t.assert_true(controller._gate_revealing(), "dismissed completed panel shows real map reveal")
	t.assert_eq(controller.attack_cooldown, 0.3, "reveal does not tick combat cooldown")
	controller._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	var reveal_time: float = controller.mogao_journey.reveal_elapsed
	controller._process(3.0)
	t.assert_eq(controller.mogao_journey.reveal_elapsed, reveal_time, "background pauses the gate animation too")
	controller._inspect_pattern()
	t.assert_true(not controller.game.is_paused(), "touch resume remains available during paused reveal")
	controller._process(2.0)
	t.assert_true(controller.mogao_journey.gate_presented, "resumed reveal finishes")
	t.assert_eq(controller.attack_cooldown, 0.3, "finishing frame never advances world time")
	controller.player.pos = controller.exit_pos
	TurnResolver.resolve_after_move(controller)
	t.assert_true(not controller.game_won, "exit still requires brother")
	controller._pick_up_item(controller._get_item_at(MogaoJourney.FAMILY))
	controller.journey_card.visible = false
	TurnResolver.resolve_after_move(controller)
	t.assert_true(controller.game_won and controller.advance_after_story, "rescue then exit opens next-chapter card")
	controller._new_game(1)
	t.assert_true(not controller.mogao_journey.gate_open and controller.mogao_journey.puzzle.latches == 0, "restart resets map and puzzle together")
	controller._new_game(0)
	t.assert_true(controller.mogao_journey == null and controller.maze.theme_key == "", "first chapter stays isolated")
	controller.queue_free()
	SaveManager.clear_save()
