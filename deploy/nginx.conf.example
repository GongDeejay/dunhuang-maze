# 敦煌迷途 — Nginx 站点示例
# 域名: maze.mplusm.site
# 将 root 指向 web/ 导出目录

server {
    listen 443 ssl http2;
    server_name maze.mplusm.site;

    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    root /www/wwwroot/maze.mplusm.site;
    index index.html;

    # Godot Web 跨域隔离（必须）
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;

    # 压缩（推荐）
    gzip on;
    gzip_types application/wasm application/javascript text/html text/css application/octet-stream;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_vary on;
    # CI generates .gz companions so Nginx avoids recompressing 40 MB WASM per request.
    gzip_static on;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* ^/(game|engine)-[0-9a-f]+\.wasm$ {
        try_files $uri =404;
        types { application/wasm wasm; }
        default_type application/wasm;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
    }

    location ~* ^/(game|engine)-[0-9a-f]+\.(pck|js|audio\.worklet\.js|audio\.position\.worklet\.js)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
    }

    location = /index.html {
        expires -1;
        add_header Cache-Control "no-cache";
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
    }

    location = / {
        try_files /index.html =404;
        expires -1;
        add_header Cache-Control "no-cache";
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
    }
}

server {
    listen 80;
    server_name maze.mplusm.site;
    return 301 https://$host$request_uri;
}
